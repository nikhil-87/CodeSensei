# =============================================================================
# Free Tier Environment Configuration
#
# This configuration uses ONLY free resources for public deployment:
#   - Groq API for LLM (free, 30 req/min, no credit card required)
#   - HuggingFace for embeddings (free, rate limited)
#   - Neon for PostgreSQL (512MB free forever)
#   - Upstash for Redis (10K commands/day free)
#   - Oracle Cloud VM (24GB RAM ARM free forever) or any free VM
#
# SETUP STEPS:
#   1. Create accounts at each service (all free, no credit card):
#      - Groq: https://console.groq.com/keys
#      - HuggingFace: https://huggingface.co/settings/tokens
#      - Neon: https://neon.tech (PostgreSQL)
#      - Upstash: https://upstash.com (Redis)
#
#   2. Fill in the API keys and connection strings below
#
#   3. Deploy: docker compose -f docker/docker-compose.free-tier.yml up -d
# =============================================================================

# ============================================================================
# Application
# ============================================================================
APP_NAME=codesensei
APP_ENV=production
APP_LOG_LEVEL=INFO
APP_DEBUG=false
# Generate with: openssl rand -base64 32
APP_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_32_CHAR_STRING

# CORS — set to your domain for production
APP_CORS_ORIGINS=*

# ============================================================================
# Authentication (GitHub OAuth + cookie sessions)
#
# Register an OAuth app at https://github.com/settings/developers and set the
# callback URL to <FRONTEND_BASE_URL>/api/v1/auth/github/callback.
# For production behind HTTPS the session cookie is automatically `secure`.
# ============================================================================
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://your-domain/api/v1/auth/github/callback
FRONTEND_BASE_URL=https://your-domain
SESSION_COOKIE_NAME=codesensei_session
SESSION_TTL_SECONDS=604800
# Keep disabled in production — the endpoint 404s unless APP_ENV is development/test.
AUTH_DEV_LOGIN_ENABLED=false

# ============================================================================
# Mock Authentication (local dev ONLY — ignored when APP_ENV=production)
# ============================================================================
# Set MOCK_AUTH=true locally to skip GitHub OAuth and log in as a mock user.
# This is HARD-DISABLED in production, so leaving it here is safe.
MOCK_AUTH=false

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_AI_CHAT_ENABLED=true
FEATURE_ANALYTICS_ENABLED=false
FEATURE_NOTIFICATIONS_ENABLED=false

# ============================================================================
# Backend API
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_REQUEST_TIMEOUT_SECONDS=120
API_MAX_REPO_SIZE_MB=100
API_MAX_REPO_FILES=2000
API_RATE_LIMIT_PER_MINUTE=30

# ============================================================================
# PostgreSQL — Neon (FREE: 512MB storage)
#
# Sign up: https://neon.tech
# Create a project, copy the connection string, extract values:
#   postgresql://[USER]:[PASSWORD]@[HOST]/[DATABASE]
# ============================================================================
POSTGRES_HOST=ep-xxx-xxx-123456.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=codesensei
POSTGRES_USER=codesensei
POSTGRES_PASSWORD=YOUR_NEON_PASSWORD_HERE
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
# Neon requires SSL
POSTGRES_SSLMODE=require

# ============================================================================
# Redis — Upstash (FREE: 10K commands/day)
#
# Sign up: https://upstash.com
# Create a Redis database, copy connection details
# ============================================================================
REDIS_HOST=xxx-xxx-12345.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_UPSTASH_PASSWORD_HERE
REDIS_DB=0
REDIS_QUEUE_NAME=analysis-jobs
REDIS_CACHE_TTL_SECONDS=3600
# Upstash requires TLS
REDIS_TLS=true

# ============================================================================
# ChromaDB — Runs locally in container (ephemeral, no external service)
# ============================================================================
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_PREFIX=repo_

# ============================================================================
# AI Provider Selection
#
# LLM_PROVIDER options:
#   - "groq" (RECOMMENDED: free, fast, 30 req/min)
#   - "ollama" (requires 8GB+ RAM, not for free VMs)
#
# EMBEDDING_PROVIDER options:
#   - "huggingface" (free API, rate limited)
#   - "local" (CPU-friendly, no API needed, uses sentence-transformers)
#   - "ollama" (requires local Ollama server)
# ============================================================================
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=huggingface

# ============================================================================
# Groq API (FREE: 30 requests/minute, no credit card)
#
# Sign up: https://console.groq.com
# Create API key at: https://console.groq.com/keys
#
# Recommended models (all free):
#   - llama-3.3-70b-versatile (best quality)
#   - llama-3.1-8b-instant (faster)
#   - mixtral-8x7b-32768 (good for code)
# ============================================================================
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ============================================================================
# HuggingFace API (FREE: rate limited, good for embeddings)
#
# Sign up: https://huggingface.co
# Create token at: https://huggingface.co/settings/tokens
# ============================================================================
HUGGINGFACE_API_KEY=hf_YOUR_HUGGINGFACE_TOKEN_HERE
HUGGINGFACE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================================
# Local Embeddings (if EMBEDDING_PROVIDER=local)
# Uses sentence-transformers locally — no API needed, CPU-friendly
# ============================================================================
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2

# ============================================================================
# Ollama — NOT USED in free tier (requires 8GB+ RAM)
# Kept for reference if you upgrade to a paid VM
# ============================================================================
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_CHAT_MODEL=deepseek-coder:6.7b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_TIMEOUT_SECONDS=120

# ============================================================================
# AI Settings
# ============================================================================
AI_MAX_CONTEXT_TOKENS=8192
AI_TOP_K_CHUNKS=8

# ============================================================================
# Worker
# ============================================================================
WORKER_CONCURRENCY=1
WORKER_JOB_TIMEOUT_SECONDS=1800
WORKER_RETRY_MAX_ATTEMPTS=3
WORKER_CLONE_DIR=/var/lib/codesensei/workspaces

# ============================================================================
# Observability — Disabled for minimal footprint
# ============================================================================
METRICS_ENABLED=false
METRICS_PORT=9100
TRACING_ENABLED=false

# ============================================================================
# Frontend
# ============================================================================
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=CodeSensei
VITE_ENABLE_AI_CHAT=true
FRONTEND_PORT=8080
