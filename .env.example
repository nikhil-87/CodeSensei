# ============================================================================
# CodeSensei — Environment Configuration
# Copy this file to `.env` and adjust values for your environment.
# ============================================================================

# ---- Application ----------------------------------------------------------
APP_NAME=codesensei
APP_ENV=development                  # development | staging | production
APP_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Authentication (GitHub OAuth + cookie sessions) ----------------------
# Register an OAuth app at https://github.com/settings/developers
#   Authorization callback URL: <FRONTEND_BASE_URL>/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=Iv23liEISUi1KvcOlnZF
GITHUB_OAUTH_CLIENT_SECRET=50b3f3a68e3f84d42c431bc30eaecdda41b3997b
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
FRONTEND_BASE_URL=http://localhost:3000
SESSION_COOKIE_NAME=codesensei_session
SESSION_TTL_SECONDS=604800
AUTH_DEV_LOGIN_ENABLED=true          # ignored unless APP_ENV is development/test

# ---- Mock Authentication (local dev / tests ONLY) -------------------------
# When true, GitHub OAuth is skipped and every request is the predefined mock
# user — handy for offline dev and running tests without OAuth credentials.
# HARD-DISABLED whenever APP_ENV=production (the flag is ignored there).
MOCK_AUTH=false
MOCK_AUTH_USERNAME=mockuser
MOCK_AUTH_EMAIL=mockuser@example.com

# ---- Feature Flags --------------------------------------------------------
# Toggle non-critical functionality without code changes.
FEATURE_AI_CHAT_ENABLED=true
FEATURE_ANALYTICS_ENABLED=false
FEATURE_NOTIFICATIONS_ENABLED=false

# ---- Backend API ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_REQUEST_TIMEOUT_SECONDS=120
API_MAX_REPO_SIZE_MB=500
API_MAX_REPO_FILES=5000
API_RATE_LIMIT_PER_MINUTE=60

# ---- PostgreSQL -----------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=codesensei
POSTGRES_USER=codesensei
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# ---- Redis ----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_QUEUE_NAME=analysis-jobs
REDIS_CACHE_TTL_SECONDS=3600
REDIS_SOCKET_TIMEOUT=10
REDIS_SOCKET_CONNECT_TIMEOUT=10

# ---- ChromaDB -------------------------------------------------------------
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_PREFIX=repo_

# ---- AI Provider Selection ------------------------------------------------
# Choose your AI providers based on your deployment:
#
# LLM_PROVIDER options:
#   - "ollama" — Local LLM (requires 8GB+ RAM, best for privacy)
#   - "groq"   — Free cloud API (30 req/min, no credit card needed)
#
# EMBEDDING_PROVIDER options:
#   - "ollama"     — Local embeddings via Ollama
#   - "huggingface" — Free cloud API (rate limited)
#   - "local"      — CPU-friendly sentence-transformers (no API needed)
#
# For FREE TIER deployment, use: LLM_PROVIDER=groq, EMBEDDING_PROVIDER=huggingface
# For LOCAL/PRIVATE deployment, use: LLM_PROVIDER=ollama, EMBEDDING_PROVIDER=ollama
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# ---- Ollama (local LLM) ---------------------------------------------------
# Used when LLM_PROVIDER=ollama or EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=deepseek-coder:6.7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=120

# ---- Groq (free cloud LLM) ------------------------------------------------
# Used when LLM_PROVIDER=groq
# Get free API key at: https://console.groq.com/keys
# Free tier: 30 requests/minute, no credit card required
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ---- HuggingFace (free cloud embeddings) ----------------------------------
# Used when EMBEDDING_PROVIDER=huggingface
# Get free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Local Embeddings (CPU-friendly) --------------------------------------
# Used when EMBEDDING_PROVIDER=local
# No API needed, runs sentence-transformers locally
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2

# ---- AI General Settings --------------------------------------------------
AI_MAX_CONTEXT_TOKENS=8192
AI_TOP_K_CHUNKS=8

# ---- Worker ---------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_JOB_TIMEOUT_SECONDS=1800
WORKER_RETRY_MAX_ATTEMPTS=3
WORKER_CLONE_DIR=/var/lib/codesensei/workspaces
WORKER_RQ_RESULT_TTL=86400

# ---- Observability --------------------------------------------------------
METRICS_ENABLED=true
METRICS_PORT=9100
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Grafana --------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Frontend (build-time, prefixed VITE_) --------------------------------
# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# UI Configuration
VITE_DEFAULT_PAGE_SIZE=20
VITE_SEARCH_DEBOUNCE=300
VITE_ANALYSIS_REFRESH_INTERVAL=2000

# Feature Flags
VITE_DEBUG=false
VITE_ENABLE_STREAMING=true
VITE_ENABLE_DARK_MODE=true

# Application Metadata
VITE_APP_NAME=CodeSensei
VITE_APP_VERSION=1.0.0
